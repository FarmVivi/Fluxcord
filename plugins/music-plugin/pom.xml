<?xml version="1.0" encoding="UTF-8"?>

<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fr.farmvivi.fluxcord</groupId>
        <artifactId>fluxcord-parent</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>music-plugin</artifactId>

    <name>Fluxcord Plugin - Music</name>
    <description>Advanced music bot plugin with playlist management and audio effects</description>

    <repositories>
        <!-- Repository pour JitPack (LavaPlayer fork) -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>

        <!-- Repository officiel lavalink (héberge lavaplayer fork dev.arbjerg) -->
        <repository>
            <id>lavalink-maven</id>
            <url>https://maven.lavalink.dev/releases</url>
        </repository>

        <!-- Snapshots of youtube-source (per-commit builds), needed until 1.18.3 is released -->
        <repository>
            <id>lavalink-snapshots</id>
            <url>https://maven.lavalink.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>

        <!-- Repository pour LavaSrc (Spotify, Deezer, Apple Music support) -->
        <repository>
            <id>TopiWTF-releases</id>
            <name>Topis Maven Repo</name>
            <url>https://maven.topi.wtf/releases</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- API module -->
        <dependency>
            <groupId>fr.farmvivi.fluxcord</groupId>
            <artifactId>fluxcord-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JDA for Discord API -->
        <dependency>
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J for logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>


        <!-- LavaPlayer fork maintenu -->
        <!-- https://maven.lavalink.dev/#/releases/dev/arbjerg/lavaplayer -->
        <dependency>
            <groupId>dev.arbjerg</groupId>
            <artifactId>lavaplayer</artifactId>
            <version>2.2.7</version>
        </dependency>

        <!-- YouTube source pour LavaPlayer. 1.18.2 (2026-07) is broken by YouTube-side changes (issues #226 #236,
             fixed on master in August/September 2026 but unreleased, see #244). Pinned to a per-commit snapshot
             of master (2026-09-17); switch back to a release as soon as 1.18.3 exists. -->
        <dependency>
            <groupId>dev.lavalink.youtube</groupId>
            <artifactId>common</artifactId>
            <version>2be8e542d3f6f178e048dca565892684c2e40177-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>dev.lavalink.youtube</groupId>
            <artifactId>v2</artifactId>
            <version>2be8e542d3f6f178e048dca565892684c2e40177-SNAPSHOT</version>
        </dependency>

        <!-- LavaSrc pour sources additionnelles (Spotify, Deezer, Apple Music, etc.) -->
        <!-- https://maven.topi.wtf/#/releases/com/github/topi314/lavasrc -->
        <dependency>
            <groupId>com.github.topi314.lavasrc</groupId>
            <artifactId>lavasrc</artifactId>
            <version>4.8.3</version>
        </dependency>
        <dependency>
            <groupId>com.github.topi314.lavasrc</groupId>
            <artifactId>protocol-jvm</artifactId>
            <version>4.8.3</version>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>dev.arbjerg</pattern>
                                    <shadedPattern>fr.farmvivi.fluxcord.shaded.dev.arbjerg</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>dev.lavalink.youtube</pattern>
                                    <shadedPattern>fr.farmvivi.fluxcord.shaded.dev.lavalink.youtube</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.github.topi314.lavasrc</pattern>
                                    <shadedPattern>fr.farmvivi.fluxcord.shaded.com.github.topi314.lavasrc
                                    </shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>