<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender with similar format to WyLog -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss'Z',UTC} [%level] [%logger{0}] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for persistent logging -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/fluxcord.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/fluxcord.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss'Z',UTC} [%level] [%logger{0}] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger configuration -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Specific logger configurations - DEBUG level for development -->
    <logger name="fr.farmvivi.fluxcord" level="DEBUG"/>

    <!--
      A plugin's own logger is named after its plugin id (PluginContextImpl), not after a package, so it
      falls outside the rule above and lands on the root INFO level. The effect is that every debug line a
      plugin writes about its own behaviour is unreachable in the one configuration meant for debugging:
      an AI Audio session spent an evening looking like transcriptions that vanished without a trace, when
      the traces were being written and dropped. One entry per plugin id, because there is no shared
      prefix to match on.
    -->
    <logger name="ai-audio-plugin" level="DEBUG"/>
    <logger name="music-plugin" level="DEBUG"/>
    <logger name="net.dv8tion.jda" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.mariadb" level="WARN"/>
    <logger name="software.amazon.awssdk" level="WARN"/>
</configuration>